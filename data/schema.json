{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "updated", "users"],
  "properties": {
    "version": { "type": "integer" },
    "updated": { "type": "string" },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["username", "reason", "evidence", "added"],
        "properties": {
          "username": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "reason": { "type": "string", "minLength": 10 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^https://letterboxd\\.com/" }
          },
          "added": { "type": "string" }
        }
      }
    }
  }
}
